# Required when hosting for others: without it, editing works only from this machine.
EDIT_KEY=
# Use 0.0.0.0 only behind your SSO proxy
HOST=127.0.0.1
PORT=8090
# Daily backups go to data/backups by default; point this at a synced folder (OneDrive/SharePoint) for off-machine copies
BACKUP_DIR=

# Sign-in: create accounts with  python server.py add-user NAME --role owner|editor|viewer
# Set to 1 when served over HTTPS (also detected from X-Forwarded-Proto)
COOKIE_SECURE=
# Optional fixed key for signing sessions; otherwise one is generated in data/.session_secret
SESSION_SECRET=

# Accounts are optional by default. Set to 1 to make everyone sign in (do this when hosting for others)
REQUIRE_LOGIN=
